#!/bin/bash
# AXE'S HUB Obfuscation Helper
# Usage: ./obfuscate.sh yourscript.lua

set -e

SCRIPT="$1"

if [ -z "$SCRIPT" ]; then
    echo "Usage: $0 <script.lua>"
    exit 1
fi

if [ ! -f "$SCRIPT" ]; then
    echo "File not found: $SCRIPT"
    exit 1
fi

echo "[1/4] Checking dependencies..."
if ! command -v git &> /dev/null; then
    echo "git is required. Install it first."
    exit 1
fi

if ! command -v lua &> /dev/null && ! command -v luajit &> /dev/null; then
    echo "lua or luajit is required. Install it first."
    exit 1
fi

echo "[2/4] Cloning Hercules Obfuscator..."
if [ ! -d "hercules-obfuscator" ]; then
    git clone https://github.com/zeusssz/hercules-obfuscator.git
fi

echo "[3/4] Running obfuscator..."
cd hercules-obfuscator

# Choose lua binary
LUA_BIN="lua"
if command -v luajit &> /dev/null; then
    LUA_BIN="luajit"
fi

# Find main entry point
if [ -f "src/init.lua" ]; then
    ENTRY="src/init.lua"
elif [ -f "init.lua" ]; then
    ENTRY="init.lua"
elif [ -f "main.lua" ]; then
    ENTRY="main.lua"
else
    echo "Could not find obfuscator entry point. Check repo structure."
    exit 1
fi

echo "[4/4] Obfuscating $SCRIPT..."
$LUA_BIN "$ENTRY" --maximum "../$SCRIPT" -o "../${SCRIPT%.lua}_protected.lua"

echo ""
echo "âœ… Done! Output: ${SCRIPT%.lua}_protected.lua"

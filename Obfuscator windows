@echo off
REM AXE'S HUB Obfuscation Helper
REM Usage: obfuscate.bat yourscript.lua

set SCRIPT=%1

if "%SCRIPT%"=="" (
    echo Usage: obfuscate.bat ^<script.lua^>
    exit /b 1
)

if not exist "%SCRIPT%" (
    echo File not found: %SCRIPT%
    exit /b 1
)

echo [1/4] Checking dependencies...
where git >nul 2>nul
if errorlevel 1 (
    echo git is required. Install it first.
    exit /b 1
)

where lua >nul 2>nul
if errorlevel 1 (
    echo lua is required. Install it first.
    exit /b 1
)

echo [2/4] Cloning Hercules Obfuscator...
if not exist "hercules-obfuscator" (
    git clone https://github.com/zeusssz/hercules-obfuscator.git
)

echo [3/4] Running obfuscator...
cd hercules-obfuscator

if exist "src\init.lua" (
    set ENTRY=src\init.lua
) else if exist "init.lua" (
    set ENTRY=init.lua
) else if exist "main.lua" (
    set ENTRY=main.lua
) else (
    echo Could not find obfuscator entry point.
    exit /b 1
)

echo [4/4] Obfuscating %SCRIPT%...
lua "%ENTRY%" --maximum "..\%SCRIPT%" -o "..\%SCRIPT:_protected.lua%_protected.lua"

echo.
echo Done! Output: %SCRIPT:_protected.lua%_protected.lua
